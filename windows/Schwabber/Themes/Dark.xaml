<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E20" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F2F2F7" />
    <SolidColorBrush x:Key="SecondaryText" Color="#A1A1A8" />
    <SolidColorBrush x:Key="PlaceholderText" Color="#6E6E75" />
    <SolidColorBrush x:Key="DisabledText" Color="#66666C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#38383C" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#2C2C30" />
    <SolidColorBrush x:Key="PanelBackground" Color="#2A2A2E" />
    <SolidColorBrush x:Key="StatusBackground" Color="#242427" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#333337" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#46464B" />
    <SolidColorBrush x:Key="ButtonHover" Color="#3E3E43" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#4A4A50" />
    <SolidColorBrush x:Key="InputBackground" Color="#2A2A2E" />
    <SolidColorBrush x:Key="InputBorder" Color="#46464B" />
    <SolidColorBrush x:Key="InputHoverBorder" Color="#5E5E64" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackground" Color="#2C2C30" />
    <SolidColorBrush x:Key="ItemHover" Color="#3A3A3F" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#1D4A7A" />
    <SolidColorBrush x:Key="AlternateRow" Color="#232326" />
    <SolidColorBrush x:Key="TrackBackground" Color="#48484E" />
    <SolidColorBrush x:Key="ThumbBackground" Color="#D8D8DE" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#55555B" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#707077" />
    <SolidColorBrush x:Key="HexBackground" Color="#1E1E20" />
    <SolidColorBrush x:Key="HexHeaderTint" Color="#29292D" />
    <SolidColorBrush x:Key="HexSelection" Color="#1F4C80" />
    <SolidColorBrush x:Key="HexHover" Color="#2D3A4C" />
    <SolidColorBrush x:Key="HexOffset" Color="#7C7C83" />
    <SolidColorBrush x:Key="PinBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="HexHeaderText" Color="#A1A1A8" />

    <!-- Built-in control templates (DataGrid, TreeView, ScrollViewer corner) read these system keys. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E20" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2A2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#66666C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1D4A7A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3A3F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F7" />
</ResourceDictionary>
