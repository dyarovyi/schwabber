<Window x:Class="Schwabber.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schwabber Help" Width="1000" Height="780" MinWidth="700" MinHeight="450"
        Icon="pack://application:,,,/Schwabber.ico" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Shared look for the guide's text blocks. -->
        <Style x:Key="H1" TargetType="Paragraph">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="H2" TargetType="Paragraph">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,26,0,6" />
        </Style>
        <Style x:Key="H3" TargetType="Paragraph">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="Paragraph">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="List">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="22,0,0,0" />
        </Style>
        <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0,3,0,5" />
        </Style>
        <Style TargetType="TableCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Contents -->
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,10">
                <TextBlock DockPanel.Dock="Top" Text="CONTENTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,8" />
                <ListBox x:Name="Contents" Background="Transparent" BorderThickness="0" SelectionChanged="OnContentsSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="SecStart">Getting started</ListBoxItem>
                    <ListBoxItem Tag="SecOpen">Opening a capture</ListBoxItem>
                    <ListBoxItem Tag="SecWindow">The main window</ListBoxItem>
                    <ListBoxItem Tag="SecTimeline">Reading the timeline</ListBoxItem>
                    <ListBoxItem Tag="SecFilter">Searching, filtering and sorting</ListBoxItem>
                    <ListBoxItem Tag="SecSelect">Selecting sessions</ListBoxItem>
                    <ListBoxItem Tag="SecActions">Session actions and export</ListBoxItem>
                    <ListBoxItem Tag="SecPins">Timeline pins</ListBoxItem>
                    <ListBoxItem Tag="SecInspector">The session inspector</ListBoxItem>
                    <ListBoxItem Tag="SecPacket">The packet inspector</ListBoxItem>
                    <ListBoxItem Tag="SecWireshark">Wireshark analysis and TLS keys</ListBoxItem>
                    <ListBoxItem Tag="SecCopy">Copying fields and bytes</ListBoxItem>
                    <ListBoxItem Tag="SecStream">Reassembling a TCP stream</ListBoxItem>
                    <ListBoxItem Tag="SecRecord">Recording live traffic</ListBoxItem>
                    <ListBoxItem Tag="SecView">View options and themes</ListBoxItem>
                    <ListBoxItem Tag="SecProtocols">Supported protocols</ListBoxItem>
                    <ListBoxItem Tag="SecKeys">Keyboard shortcuts</ListBoxItem>
                    <ListBoxItem Tag="SecLimits">Limits, files and privacy</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Guide -->
        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Column="1" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Focusable="False">
            <FlowDocument x:Name="Guide" FontFamily="Segoe UI" FontSize="13" PagePadding="34,26,34,40" LineHeight="20"
                          Foreground="{DynamicResource PrimaryText}" Background="{DynamicResource WindowBackground}" TextAlignment="Left">

                <Section x:Name="SecStart">
                    <Paragraph Style="{StaticResource H1}">Schwabber Help</Paragraph>
                    <Paragraph Style="{StaticResource Note}">Schwabber shows the TCP, UDP and ICMP conversations in a packet capture on one shared timeline, so you can see at a glance who talked to whom, when, how much, and with which protocol. It can also drill down into every packet, byte by byte.</Paragraph>
                    <Paragraph Style="{StaticResource H3}">Five-minute tour</Paragraph>
                    <List MarkerStyle="Decimal">
                        <ListItem><Paragraph>Open a capture: click <Bold>Open PCAP…</Bold>, press <Bold>Ctrl+O</Bold>, or drag a .pcap or .pcapng file onto the window.</Paragraph></ListItem>
                        <ListItem><Paragraph>Each row of the timeline is one conversation (a <Italic>session</Italic>). Its colored bar spans the time it was active, and each tick is a packet.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click a session to inspect it. Its packets are listed at the bottom of the window.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click a packet in that list (or a tick on the timeline) to open the <Bold>packet inspector</Bold>, with every field and byte of the packet.</Paragraph></ListItem>
                        <ListItem><Paragraph>Use the filter box, the <Bold>Protocols</Bold> button, <Bold>Sort</Bold> and <Bold>Zoom</Bold> to narrow things down, and click the time ruler or empty timeline space to drop <Bold>pins</Bold> for comparing sessions at one instant.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">Press F1 at any time to open this guide. Everything stays on your computer: captures are analysed locally and nothing is uploaded.</Paragraph>
                </Section>

                <Section x:Name="SecOpen">
                    <Paragraph Style="{StaticResource H2}">Opening a capture</Paragraph>
                    <Paragraph>There are several ways to open a capture file:</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Open PCAP…</Bold> on the welcome screen, or <Bold>File → Open capture…</Bold> (<Bold>Ctrl+O</Bold>).</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Drag and drop</Bold> a file onto the window, including the welcome screen. A dashed outline names the file while you drag; dropping a new file replaces the capture that is open.</Paragraph></ListItem>
                        <ListItem><Paragraph>In Explorer, right-click a capture and choose <Bold>Open with → Schwabber</Bold>, drag it onto Schwabber.exe, or pass its path on the command line.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Supported files</Paragraph>
                    <List>
                        <ListItem><Paragraph>PCAP (classic, microsecond or nanosecond timestamps, either byte order) and PCAPNG. Nanosecond timestamps are shown with microsecond precision.</Paragraph></ListItem>
                        <ListItem><Paragraph>Link types: Ethernet (including VLAN tags), loopback, raw IP, and Linux cooked capture (v1 and v2).</Paragraph></ListItem>
                        <ListItem><Paragraph>IPv4 and IPv6 carrying TCP, UDP, ICMP or ICMPv6. Other packets, non-initial IP fragments and truncated headers are counted but not shown as sessions.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">Reading a file does not need Npcap or Wireshark. Large captures load in the background; the whole capture is kept in memory, so very large files need enough RAM.</Paragraph>
                </Section>

                <Section x:Name="SecWindow">
                    <Paragraph Style="{StaticResource H2}">The main window</Paragraph>
                    <Paragraph>From top to bottom:</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Menu bar</Bold> — File, Sessions, Capture, View and Help.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Header</Bold> — the file name, the number of packets and sessions, and while recording a red “Recording · N dropped” label with a <Bold>Stop</Bold> button.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Filter row</Bold> — the search box, the <Bold>Protocols</Bold> button, <Bold>Sort</Bold>, the <Bold>Zoom</Bold> slider and the “N shown · M selected” counter (hover it for the total size of the selected sessions).</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Timeline</Bold> — the session column on the left and the time ruler and session rows on the right.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Session inspector</Bold> — details and packets of the selected session. Drag the divider above it to give it more or less room.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecTimeline">
                    <Paragraph Style="{StaticResource H2}">Reading the timeline</Paragraph>
                    <Paragraph Style="{StaticResource H3}">Sessions</Paragraph>
                    <Paragraph>A session groups all packets between the same two endpoints with the same transport, in both directions. TCP and UDP sessions are identified by IP address and port; ICMP sessions by IP addresses only. If a pair is silent for more than 60 seconds, the next packet starts a new session. This is a conversation heuristic: a port reused quickly can merge two separate connections.</Paragraph>
                    <Paragraph Style="{StaticResource H3}">The session column</Paragraph>
                    <List>
                        <ListItem><Paragraph>The <Bold>checkbox</Bold> adds the session to the selection, followed by its <Bold>number</Bold> (#1, #2…), the <Bold>protocols</Bold> detected in it (for example “TLS / TCP”), and its packet count.</Paragraph></ListItem>
                        <ListItem><Paragraph>The second line shows both <Bold>endpoints</Bold> as address:port. Hide it with <Bold>View → Show endpoints</Bold> to make rows thinner; the choice is remembered. The selected session's endpoints are always shown in the inspector.</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>percentage</Bold> and the colored fill behind the label show the session's share of all bytes in the capture file, including packets that belong to no session. Filters do not change this share. Hover the label for the exact bytes.</Paragraph></ListItem>
                        <ListItem><Paragraph>Drag the thin <Bold>↔ strip</Bold> between the column and the timeline to make the column wider or narrower. The column stays pinned on the left while the timeline scrolls sideways.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Colors</Paragraph>
                    <Table CellSpacing="0">
                        <Table.Columns><TableColumn Width="170" /><TableColumn /></Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Purple</Bold></Paragraph></TableCell><TableCell><Paragraph>DNS</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Pink</Bold></Paragraph></TableCell><TableCell><Paragraph>QUIC</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Teal</Bold></Paragraph></TableCell><TableCell><Paragraph>TLS</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Green</Bold></Paragraph></TableCell><TableCell><Paragraph>HTTP and HTTP/2</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Indigo</Bold></Paragraph></TableCell><TableCell><Paragraph>STUN</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Cyan</Bold></Paragraph></TableCell><TableCell><Paragraph>RTP media</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Mint</Bold></Paragraph></TableCell><TableCell><Paragraph>RTCP, SIP, DTLS and TURN</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Blue</Bold></Paragraph></TableCell><TableCell><Paragraph>Other TCP</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Orange</Bold></Paragraph></TableCell><TableCell><Paragraph>Other UDP, and ICMP</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H3}">Bars, ticks and the ruler</Paragraph>
                    <List>
                        <ListItem><Paragraph>The pale bar spans the session from its first to its last packet. Each solid <Bold>tick</Bold> is a packet arrival. Packets too close to tell apart at the current zoom merge into one wider <Bold>chunk</Bold> spanning them; zoom in to split it into separate ticks.</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>ruler</Bold> shows time since the first packet of the capture. Its labels and grid lines use round steps (1, 2 or 5 × 10ⁿ seconds) that get finer as you zoom in. The timeline always spans at least two seconds.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Zoom</Bold> with the slider (click a point on it to jump there). The far left fits the whole capture; the far right shows two seconds across the visible timeline (one second per half). The scale is logarithmic, so each part of the slider zooms by the same factor.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Scroll sideways</Bold> with a two-finger horizontal swipe on a touchpad, Shift+mouse wheel, a tilt wheel, or the horizontal scroll bar. The ordinary wheel or two-finger vertical swipe scrolls through the sessions.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click a <Bold>tick</Bold> to open that packet in the packet inspector, or a <Bold>chunk</Bold> to open its first packet. A plain click on empty space in the timeline drops a <Bold>pin</Bold> there. To select a session, click its label on the left (or Ctrl/Shift-click anywhere in its row).</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecFilter">
                    <Paragraph Style="{StaticResource H2}">Searching, filtering and sorting</Paragraph>
                    <Paragraph Style="{StaticResource H3}">The search box</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Addresses, ports and protocol details</Bold> match case-insensitively, for example “10.0.0.5”, “:443”, “example.com” or “ClientHello”.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Payload text</Bold> also matches: the exact, case-sensitive UTF-8 bytes inside individual packet payloads (link, IP and TCP/UDP headers are excluded).</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Hex bytes</Bold> are written as x followed by two hex digits per byte, for example <Run FontFamily="Cascadia Mono, Consolas">x16x03x01</Run>. “Invalid hex” appears in red if the pattern is malformed.</Paragraph></ListItem>
                        <ListItem><Paragraph>Payload matches stay within one packet: text split across packets, or encrypted, is not found.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Protocols</Paragraph>
                    <Paragraph>Click <Bold>Protocols</Bold> to choose which protocols to show. Checked protocols combine with OR. A transport such as UDP also includes the protocols carried over it (DNS over UDP, QUIC, RTP…). <Bold>All</Bold> shows everything; <Bold>Clear</Bold> unchecks every box, which shows no sessions until you check one.</Paragraph>
                    <Paragraph Style="{StaticResource H3}">Sort</Paragraph>
                    <Paragraph><Bold>Chronological</Bold> orders sessions by their first packet; <Bold>Largest first</Bold> by total bytes. Changing a filter or the sort order scrolls back to the top.</Paragraph>
                </Section>

                <Section x:Name="SecSelect">
                    <Paragraph Style="{StaticResource H2}">Selecting sessions</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Click</Bold> a session's label to select only it and show it in the inspector. (A plain click on its timeline pins a time instead.)</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Ctrl+click</Bold> or click its <Bold>checkbox</Bold> to add it to, or remove it from, the selection.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Shift+click</Bold> selects every shown session between the last one you clicked and this one.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>↑ / ↓</Bold> move to the previous or next session; <Bold>Shift+↑ / ↓</Bold> extend the selection; <Bold>Home / End</Bold> jump to the first or last session.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Sessions → Select shown</Bold> selects every session that passes the current filters; <Bold>Sessions → Clear selection</Bold> deselects everything.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">Selections survive filter changes, so you can collect sessions from several searches. The counter in the filter row includes hidden selections.</Paragraph>
                </Section>

                <Section x:Name="SecActions">
                    <Paragraph Style="{StaticResource H2}">Session actions and export</Paragraph>
                    <Paragraph>Right-click a session (its label or its timeline) for:</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Reassemble TCP stream…</Bold> — TCP sessions only; see “Reassembling a TCP stream”.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Inspect session</Bold> — show it in the inspector without changing the selection.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Copy 5-tuple</Bold> — copies “(source IP, source port, destination IP, destination port, protocol)”. The direction follows the first packet; ICMP ports are N/A.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Open session in Wireshark</Bold> and <Bold>Export session…</Bold> — for just this session.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Add to / Remove from selection</Bold>, and with several sessions selected, <Bold>Open selected sessions in Wireshark</Bold> and <Bold>Export selected sessions…</Bold>.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Exporting</Paragraph>
                    <Paragraph><Bold>File → Export selected sessions…</Bold> saves the selected sessions as a new .pcap file: both directions of every selected session, in original capture order, with the original packet bytes, lengths and microsecond timestamps. The source file is never changed. PCAPNG comments and interface details are not carried over.</Paragraph>
                    <Paragraph><Bold>File → Open selected in Wireshark</Bold> exports the same way to a temporary file in %TEMP%\Schwabber-Exports and opens it in Wireshark (which must be installed). Use Save As in Wireshark to keep a permanent copy.</Paragraph>
                </Section>

                <Section x:Name="SecPins">
                    <Paragraph Style="{StaticResource H2}">Timeline pins</Paragraph>
                    <Paragraph>Pins mark an exact moment across all sessions, so you can compare what different conversations did at the same instant.</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Add</Bold>: click the time ruler, or any empty space in the timeline (between packet ticks, or below the last session). A thin dashed orange line appears through every session row, with a pin marker on the ruler. Clicks within a few pixels of an existing pin do not add another.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Read the note and exact time</Bold>: hover a pin marker on the ruler to see its note and time relative to capture start, for example “Pin +2.107210 s from capture start”.</Paragraph></ListItem>
                        <ListItem><Paragraph>Add as many pins as you like. They follow zoom and scrolling. Drag a pin marker along the ruler to move it; its note follows it.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Notes</Bold>: right-click a pin marker and choose <Bold>Add note</Bold> or <Bold>Edit note</Bold>. Save your text, or cancel to keep the existing note. Use <Bold>Remove note</Bold> to clear it.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Remove</Bold>: right-click a pin marker on the ruler and choose <Bold>Remove pin</Bold>. Right-click elsewhere on the ruler to pin that exact time or to <Bold>Clear all pins</Bold>; <Bold>View → Clear timeline pins</Bold> does the same.</Paragraph></ListItem>
                        <ListItem><Paragraph>Pins and notes are cleared when another capture is opened and are not saved into the PCAP.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecInspector">
                    <Paragraph Style="{StaticResource H2}">The session inspector</Paragraph>
                    <Paragraph>The bottom of the window shows the selected session:</Paragraph>
                    <List>
                        <ListItem><Paragraph>The protocols and both endpoints, and the session duration on the right.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Session size</Bold> in bytes and kB (1 kB = 1,000 bytes) and the packet count. Sizes add up the original packet lengths in both directions, including all headers; they are not application payload sizes.</Paragraph></ListItem>
                        <ListItem><Paragraph>A one-line protocol <Bold>summary</Bold> of the session (hover it to read it all).</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>packet list</Bold>: packet number in the file, time since the capture start, <Bold>Delta time</Bold> since the previous packet of this session (either direction), source, destination, length on the wire, and protocol details (hover for the full text).</Paragraph></ListItem>
                    </List>
                    <Paragraph>Click a packet to open it in the packet inspector. With the inspector open, ↑ and ↓ in the packet list follow along.</Paragraph>
                </Section>

                <Section x:Name="SecPacket">
                    <Paragraph Style="{StaticResource H2}">The packet inspector</Paragraph>
                    <Paragraph>One inspector window is reused for every packet you open. From top to bottom:</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Previous / Next</Bold> step through the packets of the session (also <Bold>Ctrl+← / →</Bold>, <Bold>Alt+← / →</Bold>, <Bold>Page Up / Page Down</Bold>). Beside them: the packet number, its position in the session (and, when it is part of a timeline chunk, its position in that chunk at the current zoom), and its exact arrival time relative to the first packet of the capture (for example “+0.400000 s”).</Paragraph></ListItem>
                        <ListItem><Paragraph>The packet shown is <Bold>marked on the timeline</Bold> with a bright tick and a small triangle in its session row. The timeline scrolls to it if needed, and the marker follows Previous / Next. It disappears when the inspector closes.</Paragraph></ListItem>
                        <ListItem><Paragraph>The direction (source → destination) and the session's protocols.</Paragraph></ListItem>
                        <ListItem><Paragraph>Three <Bold>size cards</Bold>: <Bold>With headers</Bold> is the whole frame on the wire (and how much of it was captured); <Bold>Without headers</Bold> is the transport payload after the TCP, UDP or ICMP header; <Bold>Headers</Bold> breaks the difference down, for example “Ethernet 14 + IPv4 20 + TCP 20”, plus any Ethernet padding (trailer). An orange note warns when the capture truncated the packet.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Wireshark analysis</Bold> and <Bold>Choose TLS key log…</Bold> — see the next section.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Packet details</Bold> — the decoded field tree. Expand a layer to see its fields. Fields that only describe the packet (with no bytes of their own) are grey.</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>bytes pane</Bold> — offset, hex and ASCII, 16 bytes per row. Header and trailer bytes are shaded so the payload stands out.</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>status line</Bold> at the bottom names the selected field, its value, and its byte range in the frame and in the payload.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Linking fields and bytes</Paragraph>
                    <List>
                        <ListItem><Paragraph>Click a <Bold>field</Bold> to highlight its bytes.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click a <Bold>byte</Bold> (in hex or ASCII) to select the most specific field it belongs to; its parent layers expand automatically.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Hover</Bold> a byte for a tooltip naming its field.</Paragraph></ListItem>
                        <ListItem><Paragraph>Expanded and selected fields carry over when you move to the next packet.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Display options</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Include headers</Bold> (on by default) shows the whole frame. Turn it off to see only the transport payload, with offsets counted from the start of the payload, and only the application layers in the tree.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>ASCII only</Bold> hides the hex columns to make readable text easier to scan.</Paragraph></ListItem>
                        <ListItem><Paragraph>Drag the divider between the field tree and the bytes pane to resize them.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecWireshark">
                    <Paragraph Style="{StaticResource H2}">Wireshark analysis and TLS keys</Paragraph>
                    <Paragraph>Schwabber has its own built-in analyzer, which decodes each packet on its own. When Wireshark is installed, <Bold>Wireshark analysis</Bold> (on by default) additionally runs Wireshark's analysis engine (sharkd) locally on the whole capture file, which adds:</Paragraph>
                    <List>
                        <ListItem><Paragraph>Wireshark's own, very detailed field tree (titled “Packet details · Wireshark”).</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Reassembled and decrypted data</Bold>: messages split across several TCP segments, and TLS or QUIC content when keys are available. These appear in the <Bold>Data source</Bold> list above the bytes pane. Clicking a field that belongs to another data source switches to it. Reassembled data is often attached to the last packet of the message.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Decrypting TLS</Paragraph>
                    <Paragraph>Click <Bold>Choose TLS key log…</Bold> and pick a key log file in the NSS / SSLKEYLOGFILE format (for example, produced by a browser started with the SSLKEYLOGFILE environment variable). Decryption needs keys that match the sessions in the capture, the start of the TLS handshake in the capture, and protocol support in your Wireshark version. Schwabber never derives or downloads keys. <Bold>Clear keys</Bold> forgets the file.</Paragraph>
                    <Paragraph Style="{StaticResource H3}">Good to know</Paragraph>
                    <List>
                        <ListItem><Paragraph>Analysis re-reads the original capture file, so keep it in place and unchanged while inspecting. If it changed, Schwabber asks you to reopen it.</Paragraph></ListItem>
                        <ListItem><Paragraph>Large captures can take a while (“Analyzing capture…”); analysis stops after 120 seconds, and is cancelled when you move to another packet.</Paragraph></ListItem>
                        <ListItem><Paragraph>If Wireshark is not installed, or you turn the checkbox off, the built-in analyzer is used and everything else keeps working.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecCopy">
                    <Paragraph Style="{StaticResource H2}">Copying fields and bytes</Paragraph>
                    <Paragraph Style="{StaticResource H3}">Fields</Paragraph>
                    <List>
                        <ListItem><Paragraph>Select a field and press <Bold>Ctrl+C</Bold> to copy its whole line, for example “Server Name: www.example.org”.</Paragraph></ListItem>
                        <ListItem><Paragraph>Right-click a field for <Bold>Copy</Bold>, <Bold>Copy value</Bold> (just “www.example.org”), and <Bold>Copy bytes as hex</Bold>, <Bold>as hex stream</Bold> (no spaces) or <Bold>as text</Bold>.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H3}">Bytes</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Drag</Bold> across the bytes pane to select any range; the status line shows its offsets and length. <Bold>Ctrl+A</Bold> selects all bytes shown.</Paragraph></ListItem>
                        <ListItem><Paragraph>Press <Bold>Ctrl+C</Bold> to copy the selection as hex (“16 03 01 …”), or right-click for <Bold>hex</Bold>, <Bold>hex stream</Bold>, <Bold>text</Bold> or a <Bold>hex dump</Bold> with offsets and ASCII.</Paragraph></ListItem>
                        <ListItem><Paragraph>A highlighted field can be copied the same way.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecStream">
                    <Paragraph Style="{StaticResource H2}">Reassembling a TCP stream</Paragraph>
                    <Paragraph>Right-click a TCP session and choose <Bold>Reassemble TCP stream…</Bold>. Schwabber orders the payload of each direction by TCP sequence number, without needing Wireshark:</Paragraph>
                    <List>
                        <ListItem><Paragraph>Pick a <Bold>Direction</Bold> (source → destination) and a <Bold>Contiguous chunk</Bold>. Missing data (gaps) starts a new chunk rather than being filled in.</Paragraph></ListItem>
                        <ListItem><Paragraph>The summary counts missing, overlapping (retransmitted) and conflicting bytes; it turns orange when data is missing or conflicting. For conflicting overlaps, the first segment in sequence order wins.</Paragraph></ListItem>
                        <ListItem><Paragraph>View the chunk in hex, or tick <Bold>Text preview</Bold> to read the first 64 KiB as text. <Bold>Save chunk…</Bold> writes all of its bytes to a file.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">TLS traffic stays encrypted here; use Wireshark analysis with a key log to see decrypted content. Offsets start at the first captured byte of the direction. The view is a snapshot taken when opened.</Paragraph>
                </Section>

                <Section x:Name="SecRecord">
                    <Paragraph Style="{StaticResource H2}">Recording live traffic</Paragraph>
                    <Paragraph>Schwabber can record traffic from a network adapter and show it as it arrives. This needs <Bold>Npcap</Bold> (https://npcap.com), which is also installed with Wireshark.</Paragraph>
                    <List MarkerStyle="Decimal">
                        <ListItem><Paragraph>Choose the adapter in the list on the welcome screen or under <Bold>Capture → Interface</Bold>. Schwabber pre-selects a connected adapter; <Bold>Capture → Refresh interfaces</Bold> rescans after you plug in or connect one.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click <Bold>Record PCAP</Bold> or <Bold>Capture → Start recording</Bold>. Sessions appear and update about twice a second; the header shows how many packets the adapter dropped.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click <Bold>Stop</Bold> in the header or <Bold>Capture → Stop recording</Bold>.</Paragraph></ListItem>
                        <ListItem><Paragraph>Use <Bold>File → Save PCAP…</Bold> (<Bold>Ctrl+S</Bold>) to save the complete recording, including packets Schwabber does not decode. (Export selected sessions saves only chosen sessions.)</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">Recordings are written to %TEMP%\Schwabber-Recordings while capturing and stay there after you stop, so save important ones elsewhere. Opening files is disabled while recording. Closing the window stops the recording and finishes the file first. Capture uses the full packet length (262,144-byte snapshot), no promiscuous mode and no capture filter.</Paragraph>
                </Section>

                <Section x:Name="SecView">
                    <Paragraph Style="{StaticResource H2}">View options and themes</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>View → Show endpoints</Bold> shows or hides the address:port line under each session. Hidden, rows become thinner so more sessions fit. The choice is remembered.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>View → Clear timeline pins</Bold> removes all timeline pins.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>View → Theme</Bold> chooses <Bold>System theme</Bold> (follows the Windows app setting, even while Schwabber is open), <Bold>Light</Bold> or <Bold>Dark</Bold>. The choice is remembered.</Paragraph></ListItem>
                    </List>
                </Section>

                <Section x:Name="SecProtocols">
                    <Paragraph Style="{StaticResource H2}">Supported protocols</Paragraph>
                    <Paragraph>Protocols are recognised from packet contents, not just port numbers, and decoded packet by packet:</Paragraph>
                    <Table CellSpacing="0">
                        <Table.Columns><TableColumn Width="150" /><TableColumn /></Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Link and network</Bold></Paragraph></TableCell><TableCell><Paragraph>Ethernet and VLAN, loopback, Linux cooked capture, IPv4, IPv6 with extension headers</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Transport</Bold></Paragraph></TableCell><TableCell><Paragraph>TCP with options and flags, UDP, ICMP and ICMPv6 (type, code, echo id and sequence)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>DNS</Bold></Paragraph></TableCell><TableCell><Paragraph>Queries and answers over UDP and TCP port 53 (A, AAAA, CNAME, NS, PTR, MX, TXT…)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>HTTP, HTTP/2</Bold></Paragraph></TableCell><TableCell><Paragraph>HTTP/1 request and status lines and headers; HTTP/2 preface and frames (header blocks stay HPACK-encoded)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>TLS</Bold></Paragraph></TableCell><TableCell><Paragraph>Records, Client/ServerHello, cipher suites, SNI, ALPN, supported versions and groups</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>QUIC</Bold></Paragraph></TableCell><TableCell><Paragraph>Long-header type, version and connection IDs (payload stays encrypted)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Real-time</Bold></Paragraph></TableCell><TableCell><Paragraph>STUN and TURN, RTP (heuristic), RTCP reports, SIP with SDP, DTLS record headers</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource Note}">Encrypted content and messages split across packets need Wireshark analysis (and keys) or the TCP stream view. Checksums are shown but not verified; TCP sequence numbers are raw.</Paragraph>
                </Section>

                <Section x:Name="SecKeys">
                    <Paragraph Style="{StaticResource H2}">Keyboard shortcuts</Paragraph>
                    <Table CellSpacing="0">
                        <Table.Columns><TableColumn Width="200" /><TableColumn /></Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell ColumnSpan="2"><Paragraph><Bold>Main window</Bold></Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+O</Paragraph></TableCell><TableCell><Paragraph>Open a capture</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+S</Paragraph></TableCell><TableCell><Paragraph>Save the last recording</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>F1</Paragraph></TableCell><TableCell><Paragraph>Open this guide</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>↑ / ↓</Paragraph></TableCell><TableCell><Paragraph>Previous / next session</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Shift+↑ / Shift+↓</Paragraph></TableCell><TableCell><Paragraph>Extend the selection</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Home / End</Paragraph></TableCell><TableCell><Paragraph>First / last session</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+click</Paragraph></TableCell><TableCell><Paragraph>Add or remove a session from the selection</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Shift+click</Paragraph></TableCell><TableCell><Paragraph>Select a range of sessions</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Two-finger sideways swipe, Shift+wheel</Paragraph></TableCell><TableCell><Paragraph>Scroll the timeline left or right</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell ColumnSpan="2"><Paragraph><Bold>Packet inspector</Bold></Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+← / Ctrl+→</Paragraph></TableCell><TableCell><Paragraph>Previous / next packet (also Alt+← / →, Page Up / Page Down)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+C</Paragraph></TableCell><TableCell><Paragraph>Copy the selected field, or the selected bytes as hex</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>Ctrl+A</Paragraph></TableCell><TableCell><Paragraph>Select all bytes shown (in the bytes pane)</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph>F1</Paragraph></TableCell><TableCell><Paragraph>Open this guide</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                </Section>

                <Section x:Name="SecLimits">
                    <Paragraph Style="{StaticResource H2}">Limits, files and privacy</Paragraph>
                    <List>
                        <ListItem><Paragraph>Everything runs on your computer. Captures, recordings, key logs and analysis results are never uploaded.</Paragraph></ListItem>
                        <ListItem><Paragraph>The whole capture (including packet bytes) is held in memory, so very large captures need plenty of RAM.</Paragraph></ListItem>
                        <ListItem><Paragraph>Temporary files: Wireshark exports in %TEMP%\Schwabber-Exports, recordings in %TEMP%\Schwabber-Recordings. The theme and Show endpoints choices are stored in %LOCALAPPDATA%\Schwabber.</Paragraph></ListItem>
                        <ListItem><Paragraph>Session grouping is by endpoints with a 60-second idle split, not full TCP connection tracking.</Paragraph></ListItem>
                        <ListItem><Paragraph>Live recording needs Npcap; Wireshark analysis and “Open in Wireshark” need Wireshark. Everything else works without them.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">[schwabber] : vibecoded by dyarovyi</Paragraph>
                </Section>
            </FlowDocument>
        </FlowDocumentScrollViewer>
    </Grid>
</Window>
